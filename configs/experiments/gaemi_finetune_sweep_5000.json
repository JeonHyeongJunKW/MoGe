{
    "base_config": "configs/train/gaemi_moge2_vits_small_augmentation.json",
    "validation_config": "configs/validation/gaemi_moge2_vits_sweep_5000.json",
    "num_iterations": 5000,
    "effective_batch_size": 32,
    "warmup_steps": 200,
    "seed": 0,
    "experiments": [
        {
            "name": "e_heads_5000",
            "description": "E, extended to 5000 total steps from the common pretrained checkpoint.",
            "learning_rates": {
                "scale_head": 1e-05,
                "points_head": 3e-06
            },
            "batch_size_forward": 4
        },
        {
            "name": "e_neck_all_heads_5000",
            "description": "Frozen encoder; train shared conv neck and all four heads with existing normal and mask supervision.",
            "learning_rates": {
                "scale_head": 1e-05,
                "points_head": 3e-06,
                "neck": 1e-06,
                "normal_head": 3e-06,
                "mask_head": 3e-06
            },
            "batch_size_forward": 2
        }
    ]
}
